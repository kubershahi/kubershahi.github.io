<div class="list-groups">
  {% for content in data[1] %}
    <div class="list-group col-md-6">
      <table class="table-cv list-group-table">
        <tbody>
          <tr>
            {% if content.icon %}
              <td class="list-group-category-icon">
                <i class="{{ content.icon }}"></i>
              </td>
            {% else %}
              <td class="list-group-category-icon"></td>
            {% endif %}
            <td class="list-group-category">{{ content.name }}</td>
          </tr>
          {% if content.contact %}
            <tr>
              <td></td>
              <td class="list-group-name">
                <i class="fa-solid fa-envelope"></i>
                <a href="mailto:{{ content.contact }}">{{ content.contact }}</a>
              </td>
            </tr>
          {% endif %}
          {% if content.reference %}
            <tr>
              <td></td>
              <td class="list-group-name">
                <small class="text-muted">{{ content.reference }}</small>
              </td>
            </tr>
          {% endif %}
        </tbody>
      </table>
    </div>
  {% endfor %}
</div>
