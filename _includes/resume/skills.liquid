<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in data[1] %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-auto text-center" style="padding-right: 5px;">
          {% if content.icon %}
            <i class="{{ content.icon }}" style="color: var(--global-theme-color);"></i>
          {% endif %}
        </div>
        <div class="col-3">
          <h6 class="title font-weight-bold" style="color: var(--global-theme-color); margin-bottom: 0;">
            {{ content.name }}
          </h6>
        </div>
        <div class="col">
          <p style="word-wrap: break-word; overflow-wrap: break-word; font-size: 0.95rem; margin-bottom: 0;">
            {% for item in content.keywords %}
              {{ item -}}
              {%- unless forloop.last %}, {% endunless %}
            {% endfor %}
          </p>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
