<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in data[1] %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-3 col-sm-3 col-md-3 text-left">
          <h6 class="title font-weight-bold ml-1 ml-md-4" style="color: var(--global-theme-color);">
            {% if content.icon %}
              <i class="{{ content.icon }}"></i>
            {% endif %}
            {{ content.name }}
          </h6>
        </div>
        <div class="col-xs-9 col-sm-9 col-md-9">
          <p class="ml-1 ml-md-4" style="word-wrap: break-word; overflow-wrap: break-word; font-size: 0.95rem; text-align: justify;">
            {% for item in content.keywords %}
              {{ item -}}
              {%- unless forloop.last %}, {% endunless %}
            {% endfor %}
          </p>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
