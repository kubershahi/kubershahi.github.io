<div class="list-groups">
  {% for content in data[1] %}
    <div class="list-group col-md-12">
      <table class="table-cv list-group-table">
        <tbody>
          <tr>
            {% if content.icon %}
              <td class="list-group-category-icon" style="width: 30px;">
                <i class="{{ content.icon }}"></i>
              </td>
            {% else %}
              <td class="list-group-category-icon" style="width: 30px;"></td>
            {% endif %}
            <td class="list-group-category" style="width: 150px; word-wrap: break-word; overflow-wrap: break-word;">{{ content.name }}</td>
            <td class="list-group-name" style="word-wrap: break-word; overflow-wrap: break-word; font-size: 0.95rem;">
              {% for item in content.keywords %}
                {{ item -}}
                {%- unless forloop.last %}, {% endunless %}
              {% endfor %}
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  {% endfor %}
</div>
