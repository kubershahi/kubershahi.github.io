<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in data[1] %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-1 col-sm-1 col-md-1 text-center">
          {% if content.icon %}
            <i class="{{ content.icon }}" style="color: var(--global-theme-color);"></i>
          {% endif %}
        </div>
        <div class="col-xs-3 col-sm-3 col-md-3">
          <h6 class="title font-weight-bold ml-1 ml-md-2" style="color: var(--global-theme-color);">
            {{ content.name }}
          </h6>
        </div>
        <div class="col-xs-8 col-sm-8 col-md-8">
          <p class="ml-1 ml-md-2" style="word-wrap: break-word; overflow-wrap: break-word; font-size: 0.95rem;">
            {% for item in content.keywords %}
              {{ item -}}
              {%- unless forloop.last %} &nbsp;&nbsp;•&nbsp;&nbsp; {% endunless %}
            {% endfor %}
          </p>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
